{
  "name": "lingshi-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Lingshi Desktop tray shell",
  "author": "lingshi",
  "main": "src/main.cjs",
  "scripts": {
    "build:mac": "pnpm run prepare:bundle && electron-builder --mac dmg --publish never",
    "build:win": "pnpm run prepare:bundle && electron-builder --win msi --publish never",
    "dev": "electron .",
    "prepare:bundle": "node scripts/prepare-bundle.mjs"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.lingshi.desktop",
    "productName": "lingshi_desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".bundle/lingshi_bot",
        "to": "lingshi_bot",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "lingshi_desktop-${version}-mac.dmg"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "msi"
      ],
      "artifactName": "lingshi_desktop-${version}-win.msi"
    }
  }
}
